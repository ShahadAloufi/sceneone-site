.DS_Store
.claude/

# Local secrets — Moyasar/Supabase/Resend keys land here if `vercel env pull` is
# ever run in this directory. Never commit them; rotating a leaked key is the
# only cleanup once it is in git history.
.env*
.vercel

# Source video masters. Only the web-encoded derivatives (hero-*.mp4 + poster)
# belong in git — a 4K .mov is tens of MB and lives in history forever once
# committed. Keep the originals backed up OUTSIDE this repo.
*.mov

# Installed by Vercel at build time from package.json (the two Chromium deps for
# the PDF renderer, plus pdf-lib for counting a submission's pages). Never
# committed — the frontend stays buildless, this is serverless-only.
node_modules/

# Throwaway cache-busted copies of a page, used to preview a change when the
# browser is serving a stale styles.css / i18n.js. They are duplicates of a real
# page with versioned asset URLs baked in, so committing one would publish a
# frozen fork of it (cleanUrls puts _preview.html at /_preview). Ignored so
# `git add -A` can never pick one up.
/_preview*.html
/_bust*.html
